
extends layout 

block content
    section.page-top-section.set-bg(data-setbg='/img/hero-bg.jpeg')
        .container.text-white
            h2 SINGLE LISTING

    .site-breadcrumb
        .container
            a(href='')
                i.fa.fa-home
                | Home
            span
                i.fa.fa-angle-right
                | Single Listing

    section.page-section
        .container
            .row
                .col-lg-8.single-list-page
                    //- Show the selected photo (always a 'photo' mediaType) if available, otherwise fall back to the very first media item
                    if property.propertyPhoto && property.propertyPhoto.location
                        .sl-item.set-bg(data-setbg=`/${property.propertyPhoto.location}` style="height: 400px; background-size: cover; background-position: center;")
                    else if property.photos.length
                        .sl-item.set-bg(data-setbg=`/${property.photos[0].location}` style="height: 400px; background-size: cover; background-position: center;")

                    .single-list-content
                        .row
                            .col-xl-8.sl-title
                                h2 #{property.title}
                                p
                                    i.fa.fa-map-marker
                                    | #{property.district}
                            .col-xl-4.text-end

                        .row 
                            .col 
                                hr
                                
                        //- h3.sl-sp-title Property Details
                        .row.property-details-list
                            .col-md-6.col-sm-6
                                p
                                    i.fa.fa-th-large
                                    |  #{property.plot_size}
                                p
                                    i.fa.fa-tag
                                    |  #{property.asset_class}
                            .col-md-6.col-sm-6.text-right
                                //- p
                                //-     i.fa.fa-building-o
                                //-     |  #{view.capitalizeFirstLetter(property.category)}
                                p
                                    i.fa.fa-building-o
                                    |  #{property.available_units} Units Available
                                p
                                    i.fa.fa-money
                                    |  <strong>NGN #{view.formatCurrency(property.cost)}</strong> per unit

                        .row 
                            .col-md-6.col-sm-6
                                
                            .col-md-12.text-center
                                button.btn.btn-outline-primary.mr-3.share-btn(data-title=property.title data-url=`/property/${property.id}/${property.title.split(' ').join('-')}`)
                                    i.fa.fa-share-alt
                                    |  Share This Property

                                button.site-btn(type='button' data-toggle='modal' data-target='#verifyPropertyModal' data-property-title=property.title)
                                    i.fa.fa-check-circle
                                    | &nbsp;  Verify Property

                        //- h3.sl-sp-title Description
                        //- .description
                        //-     p
                        //-     | #{property.description}

                        //- Legal & Technical and Video are not in the list of publicly visible items
                        //- h3.sl-sp-title Legal & Technical Details
                        //- .row.property-details-list
                        //-     .col-md-6
                        //-         p #[strong Plot Number:] #{property.plot_number}
                        //-         p #[strong Title Document:] #{property.title_document_type}
                        //-     .col-md-6
                        //-         p #[strong Allottee Name:] #{property.allottee_name}
                        //-         p #[strong Survey Coordinates:] #{property.survey_coordinates}

                        //- - const video = property.photos.find(media => media.mediaType == 'video');
                        //- if (video)
                        //-     h3.sl-sp-title.bd-no Video
                        //-     .perview-video
                        //-         video(controls)
                        //-             source(src=`/${video.location}` type='video/mp4')

                        //- h3.sl-sp-title.bd-no Location
                        //- #map-canvas.pos-map

                        if referralLink
                            .row.mt-4 
                                .col-md-10
                                    .input-group.mb-2
                                        input.form-control.form-control-lg#agentCode(value=`${referralLink}` readonly)
                                .col-md-2
                                    button.btn.btn-custom.btn-lg(onclick='copyToClipboard()') 
                                        i.ti.ti-clipboard-text 
                                        | Copy Link

                .col-lg-4.col-md-7.sidebar
                    .related-properties
                        h2 Related Property
                        each property in relatedProperties
                            .rp-item
                                a(href=`/property/${property.id}/${property.title.split(' ').join('-')}`)
                                    .rp-pic.set-bg(data-setbg=`/${(property.propertyPhoto || property.PropertyMedia[0]) && (property.propertyPhoto || property.PropertyMedia[0]).location}`)
                                        .sale-notic FOR SALE
                                .rp-info
                                    h5 #{property.title}
                                    p
                                        i.fa.fa-map-marker
                                        | #{property.district}
                                a.rp-price(href=`/property/${property.id}/${property.title.split(' ').join('-')}`) N#{view.formatCurrency(property.cost)}

block Modals
    include includes/verify-property-modal.pug

block scriptBlock 
    script.

        const signupForm = document.getElementById("form-signup");
        const appointmentForm = document.getElementById("form-appointment");
        const addToWishlistBtn = document.getElementById("add-to-wishlist");
        let appointmentTime;

        signupForm && signupForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            appointmentTime = document.querySelector('input[type="datetime-local"]').value;
            const data = new FormData(this);
            const formData = serialize(data);
            const res = await postForm("/signup", formData);
            if (res.status.trim() == 'success') {
                document.getElementById('form-signup').classList.add('d-none');
                document.getElementById('date').innerHTML = new Date(appointmentTime).toLocaleDateString('en-GB');
                document.getElementById('time').innerHTML = new Date(appointmentTime).toLocaleTimeString('en-GB');
                document.getElementById('userPane').classList.remove('d-none');
            } else {
                alert(res.message || 'Error occurred')
            }
        });

        appointmentForm && appointmentForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            appointmentTime = document.querySelector('input[type="datetime-local"]').value;
            const data = new FormData(this);
            const formData = serialize(data);
            const res = await postForm("/book-appointment", formData);
            if (res.status.trim() == 'success') {
                document.getElementById('form-appointment').classList.add('d-none');
                document.getElementById('date').innerHTML = new Date(appointmentTime).toLocaleDateString('en-GB');
                document.getElementById('time').innerHTML = new Date(appointmentTime).toLocaleTimeString('en-GB');
                document.getElementById('userPane').classList.remove('d-none');
            } else {
                alert(res.message || 'Error occurred')
            }
        });

        addToWishlistBtn && addToWishlistBtn.addEventListener('click', async function() {
            const PropertyId = this.dataset.propertyid;
            const referral_code = this.dataset.referral_code;
            const res = await fetch('/add-to-wishlist', {
                method: 'POST',
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ PropertyId, referral_code })
            });
            if (res.status.trim() == 'success') {
                document.getElementById('wishListPane').classList.remove('d-none');
            }
        });

        function copyToClipboard() {
            var copyText = document.getElementById("agentCode");

            // Select the text field
            copyText.select();
            copyText.setSelectionRange(0, 99999); // For mobile devices

            // Copy the text inside the text field
            navigator.clipboard.writeText(copyText.value);

            alert("Referral link copied to clipboard")
        }