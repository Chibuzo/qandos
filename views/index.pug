extends layout

block styleBlock 
    style.
        .over-lay { background-color: rgba(0, 0, 0, 0.5) !important; height: 100vh }
        .service-icon-box { width: 60px; height: 60px; min-width: 60px; background-color: #bdab2d; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .service-icon-box i { color: white !important; margin: 0 !important; padding: 0 !important; float: none !important; height: auto !important; width: auto !important; background: transparent !important; }
        .service-text-custom { padding-left: 0 !important; padding-top: 5px; }
        .how-slider .how-item { position: relative; padding: 10px; }
        .how-slider img { width: 100% !important; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .how-slider .owl-nav { position: static; }
        .how-slider .owl-nav .owl-prev, .how-slider .owl-nav .owl-next { display: flex; align-items: center; justify-content: center; position: absolute; top: 50%; transform: translateY(-50%); background: #bdab2d !important; color: white !important; width: 45px; height: 45px; border-radius: 50%; font-size: 20px; z-index: 100; transition: all 0.3s; box-shadow: 0 4px 10px rgba(0,0,0,0.2); border: none !important; padding: 0 !important; }
        .how-slider .owl-nav .owl-prev { left: -25px; }
        .how-slider .owl-nav .owl-next { right: -25px; }
        .how-slider .owl-nav .owl-prev:hover, .how-slider .owl-nav .owl-next:hover { background: #132758 !important; }
        .how-slider .owl-dots { text-align: center; margin-top: 20px; display: none !important; }
        .how-slider .owl-dots .owl-dot span { width: 12px; height: 12px; margin: 5px 7px; background: #d6d6d6; display: block; transition: opacity .2s ease; border-radius: 30px; }
        .how-slider .owl-dots .owl-dot.active span { background: #bdab2d; }



